#!/bin/bash
set -euo pipefail

if ! hyprctl monitors | grep -q "^Monitor DP-3"; then
  echo "DP-3 not connected; skipping workspace dispatch"
  exit 0
fi

if ! hyprctl monitors | grep -q "^Monitor DP-2"; then
  echo "DP-2 not connected; skipping workspace dispatch"
  exit 0
fi

hyprctl dispatch moveworkspacetomonitor 1 DP-3
hyprctl dispatch moveworkspacetomonitor 2 DP-3
hyprctl dispatch moveworkspacetomonitor 3 DP-2
hyprctl dispatch moveworkspacetomonitor 4 DP-2
hyprctl dispatch moveworkspacetomonitor 5 DP-3

echo "Dispatched workspaces: 1,2,5 -> DP-3 and 3,4 -> DP-2"
